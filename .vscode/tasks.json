            "presentation": {
                "reveal": "never",
                "panel": "dedicated"
            },
            "group": "build",
            "detail": "npm run build-cli -- --sourcemap --watch",
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
     ]
